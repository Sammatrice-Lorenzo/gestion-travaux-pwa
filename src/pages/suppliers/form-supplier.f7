<template>
  <div id="page-form-supplier" class="page" data-name="form">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Retour</span>
          </a>
        </div>
        <div class="title">${formService.getPageTitle()}</div>
      </div>
    </div>
    <div class="page-content">
      <form id="form-supplier">
        <div class="block-title">${formService.getBlockTitle()}</div>
        <div class="list list-strong-ios list-dividers-ios list-outline-ios">
          <ul>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Nom : </div>
                  <div class="item-input-wrap">
                    <input name='name' type="text" placeholder="Nom fournisseur" required validate />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Adresse : </div>
                  <div class="item-input-wrap">
                    <input name='address' type="text" placeholder="Rue" required validate />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Ville : </div>
                  <div class="item-input-wrap">
                    <input name='city' type="text" placeholder="Paris" />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label"> Pays: </div>
                  <div class="item-input-wrap">
                    <input name='country' type="text" placeholder="France" required validate />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Numéro de téléphone :</div>
                  <div class="item-input-wrap">
                    <input
                      name="phone"
                      type="tel"
                      placeholder="+33 6 12 34 56 78"
                      pattern="^(?:(?:\+|00)\d{1,3}[\s.-]?)?(?:\(?\d+\)?[\s.-]?){5,}$"
                      validate
                    />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label"> Numéro de TVA : </div>
                  <div class="item-input-wrap">
                    <input name='vatNumber' type="text" placeholder="FR32123456789" validate />
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </form>
      <div class="grid grid-cols-3 gap-4 justify-items-center items-center">
        <button class="button button-small button-round button-tonal btn-save" @click="${async () => await formService.send()}">
          <i class="icon f7-icons">checkmark</i>
        </button>
      </div>
    </div>
  </div>
</template> 
<script>
  import Framework7 from 'framework7/bundle'
  import Dom7 from 'dom7'

  import SupplierUpdateService from '../../js/service/supplier/SupplierUpdateService.ts'
  import SupplierCreateService from '../../js/service/supplier/SupplierCreateService.ts'
  import Supplier from '../../js/Supplier.ts'

  export default async (props, {$, $on, $f7, $onBeforeUnmount, page } ) => {
    const supplier = new Supplier($f7)

    let formService 
    if (props && props.supplierId) {
      const supplierId = props.supplierId
      formService = new SupplierUpdateService($f7, supplierId, supplier, 'form-supplier')
    } else {
      formService = new SupplierCreateService($f7, supplier, 'form-supplier')
    }

    $on('pageBeforeIn', () => {
      formService.initForm()
    })

    return $render
  }

</script>

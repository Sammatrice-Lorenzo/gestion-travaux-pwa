<template>
  <div id="show-suppliers" class="page">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Retour</span>
          </a>
        </div>
        <div class="title">Fiche fournisseur</div>
      </div>
    </div>

    <div class="page-content">
      <div class="block-title display-flex justify-content-space-between align-items-center">
        <span class="text-lg font-bold">Informations fournisseur</span>
        <div class="display-flex gap justify-content-end actions">
          <a href="/form-supplier/update/${props.supplierId}" class="link icon-only">
            <i class="f7-icons">square_pencil_fill</i>
          </a>
          <a id="${props.supplierId}" href="#" class="link icon-only color-red delete" @click="${openConfirm}">
            <i class="f7-icons">trash_circle_fill</i>
          </a>
        </div>
      </div>

      <div class="card">
        <div class="card-content">
          <div class="list inset">
            <ul>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">building</i>
                  </div>
                  <div class="item-inner">
                    <div data-testid="name-client" class="item-title">${supplier.name}</div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">briefcase_fill</i>
                  </div>
                  <div class="item-inner">
                    <div class="item-title">Adresse</div>
                    <div class="item-after">${supplier.address}</div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">map_fill</i>
                  </div>
                  <div class="item-inner">
                    <div class="item-title">Ville</div>
                    <div class="item-after">${supplier.city}</div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">number_circle</i>
                  </div>
                  <div class="item-inner">
                    <div class="item-title">Pays</div>
                    <div class="item-after">${supplier.country}</div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">phone_fill</i>
                  </div>
                  <div class="item-inner">
                    <div class="item-title">Téléphone</div>
                    <div class="item-after">${getPhoneNumberInString(supplier.phone)}</div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content">
                  <div class="item-media">
                    <i class="icon f7-icons">chart_pie</i>
                  </div>
                  <div class="item-inner">
                    <div class="item-title">Numéro de TVA</div>
                    <div class="item-after">${supplier.vatNumber}</div>
                  </div>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
  import Framework7 from 'framework7/bundle';
  import Dom7 from 'dom7';

  import { getPhoneNumberInString } from '../../js/helper/phoneNumberHelper.ts'
  import { CONFIRMATION_TO_DELETE } from '../../js/messages.js'
  import { loadTabbar } from '../../js/components/tabbar.js'
  import Supplier from '../../js/supplier.ts'

  export default async (props, { $, $on, $f7 }) => {
    const $$ = Dom7

    const supplierManager = new Supplier($f7)

    const supplier = await supplierManager.findSupplier(props.supplierId)
    $on('pageInit', function (page) {
      loadTabbar('show-suppliers', $f7)
    })

    const openConfirm = () => {
      $f7.dialog.confirm(CONFIRMATION_TO_DELETE, async function () {
        await supplierManager.deleteSupplier($$('.delete')[0].id, $f7)
      })
    }

    return $render
  }
</script>
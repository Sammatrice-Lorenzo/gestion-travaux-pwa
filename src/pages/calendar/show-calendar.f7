<template>
  <div id="page-calendar-work-event-day" class="page">
    <div class="navbar no-shadow">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a class="link back">
            <i class="icon icon-back"></i>
            <span class="if-not-md">Retour</span>
          </a>
        </div>
        <div class="right">
          <a
            href="#"
            class="link icon-only popup-open"
            data-popup=".popup-search-work-event-day"
            data-tooltip="Rechercher des prestations"
            data-testid="open-search-work-event-day"
          >
            <i class="icon f7-icons">search</i>
          </a>
          <a href="#" download class="link icon-only" @click="${downloadCalendar}">
            <i class="icon f7-icons">arrow_down_circle_fill</i>
          </a>
        </div>
      </div>
    </div>
    <div class="page-content">
      <div id="calendar" class="block block-strong no-padding no-margin no-hairline-top"></div>

      <div class="popup popup-search-work-event-day">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">Rechercher des prestations</div>
              <div class="right">
                <a class="link popup-close">
                  <i class="f7-icons">xmark_circle</i>
                </a>
              </div>
            </div>
          </div>
          <div class="page-content">
            <form id="form-work-event-day-search" class="block">
              <div class="list no-hairlines-md list inset no-margin">
                <ul style="margin: 0;">
                  <li class="item-content item-input">
                    <div class="item-media"><i class="f7-icons">search</i></div>
                    <div class="item-inner">
                      <div class="item-title item-label">Rechercher (expression régulière)</div>
                      <div class="item-input-wrap">
                        <input
                          name="search"
                          type="search"
                          placeholder="^Peinture.*"
                          value="${searchCriteria.search}"
                          @input="${(e) => updateSearchCriteria('search', e.target.value)}"
                        />
                      </div>
                    </div>
                  </li>
                  <li class="item-content item-input item-input-with-value">
                    <div class="item-media"><i class="f7-icons">person_alt_circle</i></div>
                    <div class="item-inner">
                      <div class="item-title item-label">Client</div>
                      <div class="item-input-wrap">
                        <select name="client" value="${searchCriteria.client}" @change="${(e) => updateSearchCriteria('client', e.target.value)}">
                          <option value="">Tous</option>
                          ${clients.map((client) => $h`<option value="${client.id}">${client.name}</option>`)}
                        </select>
                      </div>
                    </div>
                  </li>
                  <li class="item-content item-input item-input-with-value">
                    <div class="item-media"><i class="f7-icons">calendar</i></div>
                    <div class="item-inner">
                      <div class="item-title item-label">Date début</div>
                      <div class="item-input-wrap">
                        <input
                          name="startDate"
                          type="date"
                          value="${searchCriteria.startDate}"
                          @change="${(e) => updateSearchCriteria('startDate', e.target.value)}"
                        />
                      </div>
                    </div>
                  </li>
                  <li class="item-content item-input item-input-with-value">
                    <div class="item-media"><i class="f7-icons">calendar</i></div>
                    <div class="item-inner">
                      <div class="item-title item-label">Date fin</div>
                      <div class="item-input-wrap">
                        <input
                          name="endDate"
                          type="date"
                          value="${searchCriteria.endDate}"
                          @change="${(e) => updateSearchCriteria('endDate', e.target.value)}"
                        />
                      </div>
                    </div>
                  </li>
                </ul>
              </div>
              <div class="display-flex justify-content-center margin-top">
                <a
                  href="#"
                  class="button button-fill button-round"
                  data-testid="submit-search-work-event-day"
                  @click="${searchWorkEventDaysInPopup}"
                >
                  <i class="f7-icons">search</i>
                  Rechercher
                </a>
              </div>
            </form>

            ${searchResults !== null && $h`
              <div class="block-title" data-testid="search-work-event-day-count">${searchResults.length} résultat${searchResults.length > 1 ? 's' : ''}</div>
              <div class="list no-hairlines-md list inset">
                <ul>
                  ${searchResults.length === 0 && $h`
                    <li class="item-content">
                      <div class="item-inner">
                        <div class="item-title text-color-gray">Aucune prestation ne correspond à cette recherche</div>
                      </div>
                    </li>
                  `}
                  ${searchResults.map((result) => $h`
                    <li class="item-content">
                      <div class="item-inner">
                        <div class="item-title-row">
                          <div class="item-title">${result.title}</div>
                        </div>
                        <div class="item-subtitle">
                          ${new Date(result.startDate).toLocaleDateString('fr-FR')} → ${new Date(result.endDate).toLocaleDateString('fr-FR')}
                        </div>
                        <div class="item-text">${result.client ? result.client.name : 'Aucun client'}</div>
                      </div>
                    </li>
                  `)}
                </ul>
              </div>

              <div class="list no-hairlines-md list inset no-margin">
                <ul style="margin: 0;">
                  <li class="item-content item-input item-input-with-value">
                    <div class="item-inner">
                      <div class="item-title item-label">Format d'export</div>
                      <div class="item-input-wrap">
                        <select
                          name="export-format"
                          value="${exportFormat}"
                          @change="${(e) => { exportFormat = e.target.value; $update() }}"
                        >
                          <option value="pdf">PDF</option>
                          <option value="xlsx">Excel</option>
                        </select>
                      </div>
                    </div>
                  </li>
                </ul>
              </div>
              <div class="display-flex justify-content-center margin-top" style="padding-bottom: 1rem;">
                <a
                  href="#"
                  class="button button-fill button-round color-green ${searchResults.length === 0 ? 'disabled' : ''}"
                  data-testid="export-search-work-event-day"
                  @click="${exportWorkEventDaySearch}"
                >
                  <i class="f7-icons">arrow_down_circle</i>
                  Exporter
                </a>
              </div>
            `}
          </div>
        </div>
      </div>
      <div class="popup popup-swipe">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
              <div class="navbar-inner">
                <div class="title title-popup">Créer un nouveau événement</div>
                <div class="right">
                  <a class="link popup-close">
                    <i class="f7-icons">xmark_circle</i>
                  </a>
                </div>
              </div>
            </div>
            <div class="page-content">
              <div class="display-flex justify-content-center align-items-center">
                <form id="form-calendar">
                  <div class="block-title text-align-center">
                    <p>Création prestation jour</p>
                  </div>
                  <div class="list list-strong-ios list-dividers-ios list-outline-ios no-hairlines-md">
                    <ul>
                      <li class="item-content item-input">
                        <div class="item-inner">
                            <div class="item-title item-label">Titre : </div>
                            <div class="item-input-wrap">
                              <input name='title' type="text" placeholder="RDV chez le client" required validate/>
                            </div>
                        </div>
                      </li>
                      <li class="item-content item-input">
                        <div class="item-inner">
                          <div class="item-title item-label">Heure de début : </div>
                          <div class="item-input-wrap">
                            <input name='startHours' type="time" value="08:00" required validate/>
                          </div>
                        </div>
                      </li>
                      <li class="item-content item-input">
                        <div class="item-inner">
                          <div class="item-title item-label">Heure de fin : </div>
                          <div class="item-input-wrap">
                            <input name='endHours' type="time" value="18:00" required validate/>
                          </div>
                        </div>
                      </li>
                      <li class="item-content item-input">
                        <div class="item-media">
                          <i class="icon f7-icons" id="color-picker-spectrum-value">paintbrush_fill</i>
                        </div>
                        <div class="item-inner">
                          <div class="item-title item-label">Couleur : </div>
                          <div class="item-input-wrap">
                            <input
                              id="color-picker-spectrum"
                              name='color'
                              type="text"
                              placeholder="Couleur" 
                              readonly="readonly"
                              required validate
                            />
                          </div>
                        </div>
                      </li>
                        <li class="item-content item-input">
                          <div class="item-media">
                            <i class="icon f7-icons">person_alt_circle</i>
                          </div>
                          <div class="item-inner">
                            <div class="item-input-wrap">
                              <a
                                class="item-link smart-select smart-select-init"
                                data-open-in="popup"
                                data-searchbar="true"
                                data-searchbar-placeholder="Rechercher le client"
                                data-close-placeholder="Fermer"
                              >
                                <select name="client">
                                  ${clients.map((client) => $h`
                                    <option value='${client.id}.${client.name}'>${client.name}</option>
                                  `)}
                                  <option value="" selected>Aucun</option>
                                </select>
                                  <div class="item-content">
                                    <div class="item-inner">
                                      <div class="item-title">Client</div>
                                    </div>
                                  </div>
                                </a>
                            </div>
                          </div>
                        </li>
                    </ul>
                    <div class="grid grid-cols-3 gap-4 justify-items-center items-center margin-top">
                      <button id="btn-send" href="#" class="button button-small button-round button-tonal btn-save" @click="${send}">
                        <i class="icon f7-icons">checkmark</i>
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
        </div>
      </div>
      <div id="calendar-events" class="list no-margin no-hairlines no-safe-area-left">
        <ul>
          ${eventItems.length > 0 && eventItems.map((item) => $h`
            <li class="item-content swipeout">
              <div class="event-color" style="background-color: ${item.color}"></div>
              <div class="item-inner swipeout-content tooltip-init" data-id="${item.id}" data-tooltip="${showNameEvent(item)}">
                <div class="item-title">${showNameEvent(item)}</div>
                <div class="item-after">
                  <p class="event-times">${item.startTime}</p>
                  <p class="event-times">${item.endTime}</p>
                </div>
                <div id="${item.id}" class="id-work-event-day"></div>
              </div>
              <div class="swipeout-actions-right">
                <a class="edit-event" href="#" @click="${edit}">
                  <i class="f7-icons">square_pencil</i>
                </a>
                <a class="swipeout-delete" @click="${async (e) => {
                  await calendarWorkEventDayService.removeEvent(e, $f7)
                  await refreshEvents()
                }}">
                  <i class="f7-icons">trash</i>
                </a>
              </div>
            </li>
          `)}
            ${eventItems.length === 0 && $h`
              <li class="item-content">
                <div class="item-inner">
                  <div class="item-title text-color-gray">Pas d'événement ce jour</div>
                </div>
              </li>
            `}
            <a
              data-testid="open-modal-work-event-day"
              href="#"
              class="display-flex justify-content-center button-raised col popup-open"
              data-popup=".popup-swipe"
            >
              <i class="f7-icons">calendar_badge_plus</i>
            </a>
        </ul>
      </div>
    </div>
  </div>
</template>
<script>
  import { formatDate } from '../../js/helper/date.ts'
  import { monthsEnum } from '../../js/enum/monthEnum.js'
  import { renderEventsCalendar, showNameEvent } from '../../js/service/calendar/renderCalendarService.ts'
  import { CalendarWorkEventDayFormService } from '../../js/service/calendar/CalendarWorkEventDayFormService.ts'
  import { createCalendar } from '../../js/service/calendar/createCalendarService.ts'
  import { handleEditClassForm } from '../../js/service/calendar/calendarForm.ts'
  import { createColorPickerForEventCalendar } from '../../js/service/calendar/colorPickerEventCalendar.ts'
  import {
    getWorkEventDayByUser,
    updateWorkEventDay,
    downloadCalendarEvents
  } from '../../js/workEventDay.ts'
  import { getEventsFormatted } from '../../js/formatter/eventsFormatter.js'
  import { getClientsByUser } from '../../js/client/client.js'
  import { CalendarWorkEventDaySearchService } from '../../js/service/calendar/CalendarWorkEventDaySearchService.ts'

  const toDateInputValue = (date) => date.toISOString().slice(0, 10)

  export default async (props, { $f7, $, $el, $update, $on, $onMounted }) => {
    const clients = await getClientsByUser($f7)
    const workEventDays = await getWorkEventDayByUser($f7)
    let events = getEventsFormatted(workEventDays)
    const calendarWorkEventDayService = new CalendarWorkEventDayFormService(events)
    const calendarWorkEventDaySearchService = new CalendarWorkEventDaySearchService()

    let calendar
    let popupSwipe
    let colorPickerSpectrum
    let eventItems = []

    const today = new Date()
    const inAWeek = new Date(today)
    inAWeek.setDate(inAWeek.getDate() + 7)

    let searchCriteria = {
      client: '',
      search: '',
      startDate: toDateInputValue(today),
      endDate: toDateInputValue(inAWeek),
    }
    let searchResults = null
    let exportFormat = 'pdf'

    const renderEvents = async (calendar, isMonthUpdated = false) => {
      if (isMonthUpdated) {
        const eventsDay = await getWorkEventDayByUser($f7, calendar)
        events = getEventsFormatted(eventsDay)
        calendar.params.events = events
        calendar.update()
      }
      calendarWorkEventDayService.setEvents(events)
      eventItems = await renderEventsCalendar(calendar, events)
      calendarWorkEventDayService.setEventItems(eventItems)
      $update()
    }

    const refreshEvents = async () => {
      const eventsDay = await getWorkEventDayByUser($f7, calendar)
      events = getEventsFormatted(eventsDay)
      calendar.params.events = events
      calendar.update()
      calendarWorkEventDayService.setEvents(events)
      eventItems = await renderEventsCalendar(calendar, events)
      calendarWorkEventDayService.setEventItems(eventItems)
      $update()
    }

    $on('pageInit', async () => {
      calendar = await createCalendar($f7, renderEvents, events)
      colorPickerSpectrum = createColorPickerForEventCalendar($f7)
    })

    const send = async (e) => {
      e.preventDefault()
      await calendarWorkEventDayService.send($f7, popupSwipe)
      await refreshEvents()
    }

    const edit = (element) => {
      calendarWorkEventDayService.edit($f7, element)
      popupSwipe.open()
    }

    const downloadCalendar = async () => await downloadCalendarEvents(calendar, $f7)

    const updateSearchCriteria = (field, value) => {
      searchCriteria = { ...searchCriteria, [field]: value }
      $update()
    }

    const searchWorkEventDaysInPopup = async (e) => {
      e.preventDefault()
      searchResults = await calendarWorkEventDaySearchService.search(
        $f7,
        searchCriteria,
        'form-work-event-day-search',
      )
      $update()
    }

    const exportWorkEventDaySearch = async (e) => {
      e.preventDefault()
      if (!searchResults || searchResults.length === 0) {
        return
      }
      await calendarWorkEventDaySearchService.export($f7, searchCriteria, exportFormat)
    }

    handleEditClassForm($f7)

    $onMounted(() => {
      popupSwipe = $f7.popup.create({
        el: '.popup-swipe',
        swipeToClose: true,
      })
      $f7.popup.create({
        el: '.popup-search-work-event-day',
        swipeToClose: true,
      })
    })

    return $render
  }
</script>
{
  "name": "gestion-travaux-pwa",
  "private": true,
  "version": "2.5.0",
  "description": "gestion-travaux-pwa",
  "repository": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run dev",
    "start prod": "npm run prod",
    "dev": "cross-env NODE_ENV=development vite",
    "prod": "cross-env NODE_ENV=production vite",
    "test": "cross-env NODE_ENV=test vite",
    "test-server": "yarn test",
    "test:e2e": "playwright test",
    "prebuild": "node inject-firebase-env.js",
    "build": "npm run prebuild && cross-env NODE_ENV=production vite build && npx workbox generateSW workbox-config.js",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,js,css,json,md,yml,f7}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@isaacs/brace-expansion": "^5.0.1",
    "brace-expansion": "^2.0.3",
    "dom7": "^4.0.6",
    "firebase": "^9.22.0",
    "flatted": "^3.4.2",
    "framework7": "^8.0.3",
    "framework7-icons": "^5.0.5",
    "js-yaml": "4.1.1",
    "jsonwebtoken": "^9.0.0",
    "jws": "^3.2.0",
    "jwt-decode": "^3.1.2",
    "material-icons": "^1.13.5",
    "minimatch": "^10.2.3",
    "pdfjs-dist": "^5.4.149",
    "picomatch": "^4.0.4",
    "postcss": "^8.4.38",
    "rollup": "^4.59.0",
    "sass-migrator": "^2.3.1",
    "serialize-javascript": "^7.0.5",
    "skeleton-elements": "^4.0.1",
    "svelte-routing": "^1.6.0",
    "swiper": "^12.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-replace": "^5.0.2",
    "@types/node": "^22.15.17",
    "cpy-cli": "^4.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^10.1.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "postcss-preset-env": "^8.3.2",
    "prettier": "^3.5.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-framework7": "^1.2.1",
    "sass": "^1.98.0",
    "vite": "^8.0.3",
    "workbox-cli": "^7.4.0"
  },
  "resolutions": {
    "tmp": "^0.2.4"
  }
}
